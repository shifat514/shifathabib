---
interface Props {
  index: string;
  title: string;
  titleId?: string;
}
const { index, title, titleId } = Astro.props;
---

<div class="mx-auto grid max-w-site gap-2 px-6 pb-4 pt-6 md:grid-cols-12 md:gap-8 md:px-10">
  <p class="font-mono text-xs tracking-[0.15em] text-muted md:col-span-3">
    {index}
  </p>
  <h2
    id={titleId}
    class="font-display text-2xl font-medium tracking-tight md:col-span-9"
  >
    {title}
  </h2>
</div>
