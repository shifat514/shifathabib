---
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);

const linkClass = (href: string) =>
  `px-1 hover:bg-accent hover:text-background ${
    isActive(href) ? "bg-accent text-background" : ""
  }`;
---

<div class="flex justify-center px-4 z-100 font-jersey text-accent text-2xl">
  <div class="max-w-[1000px] w-full relative">
    <nav aria-label="Main" class="py-9 hidden sm:block">
      <div class="flex justify-between items-center">
        <div class="flex justify-start gap-x-4">
          <a href="/" class={linkClass("/")}>{isActive("/") ? "> " : ""}home</a>
          <a href="/about" class={linkClass("/about")}
            >{isActive("/about") ? "> " : ""}about</a
          >
          <a href="/projects" class={linkClass("/projects")}
            >{isActive("/projects") ? "> " : ""}projects</a
          >
        </div>
        <div class="flex gap-x-4">
          <a
            target="_blank"
            rel="noopener noreferrer"
            href="https://github.com/shifat514"
            aria-label="GitHub"
          >
            <svg
