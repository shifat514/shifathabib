<style>
  #menubar {
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition:
      opacity 200ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #menubar.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    #menubar {
      transition: none;
    }
  }
</style>
<script>
  const button = document.getElementById("nav-toggle");
  const btn1 = document.getElementById("menu");
  const btn2 = document.getElementById("cross");
  const panel = document.getElementById("menubar");
  let open = false;

  function setOpen(next: boolean) {
    open = next;
    button?.setAttribute("aria-expanded", String(open));
    btn1?.classList.toggle("hidden", open);
    btn2?.classList.toggle("hidden", !open);
    panel?.classList.toggle("open", open);
    if (panel) (panel as HTMLElement).inert = !open;
  }

  button?.addEventListener("click", (event) => {
    event.stopPropagation();
    setOpen(!open);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && open) setOpen(false);
  });

  document.addEventListener("click", (event) => {
    if (!open) return;
    const target = event.target as Node;
    if (panel?.contains(target) || button?.contains(target)) return;
    setOpen(false);
  });

  panel?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });
</script>
