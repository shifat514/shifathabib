---
interface Props {
  title: string;
  meta: string;
  href?: string;
  years: string;
  metric: { value: string; label: string };
  problem: string;
  built: string[];
  stack: string[];
}
const { title, meta, href, years, metric, problem, built, stack } = Astro.props;
---

<article class="border-t border-line">
  <div
    class="mx-auto grid max-w-site gap-10 px-6 py-14 md:grid-cols-12 md:gap-8 md:px-10 md:py-20"
  >
    <aside class="flex gap-10 md:col-span-3 md:flex-col md:justify-between md:gap-0">
      <div>
        <p class="font-display text-5xl font-medium tracking-tight text-amber md:text-6xl">
          {metric.value}
        </p>
        <p class="mt-3 max-w-[18ch] font-mono text-[11px] uppercase leading-relaxed tracking-[0.15em] text-muted">
          {metric.label}
        </p>
      </div>
      <p class="ml-auto font-mono text-xs tracking-[0.15em] text-muted md:ml-0 md:mt-10">
        {years}
      </p>
    </aside>

    <div class="md:col-span-8 lg:col-span-7">
      <h3 class="font-display text-3xl font-semibold tracking-tight md:text-4xl">
        {title}
      </h3>
      <p class="mt-3 font-mono text-xs uppercase tracking-[0.15em] text-muted">
        {
          href ? (
            <a href={href} class="u-link" rel="noopener">
              {meta} ↗
            </a>
          ) : (
            meta
          )
        }
      </p>

      <p class="mt-8 max-w-[62ch] text-[1.0625rem] leading-relaxed">
        {problem}
      </p>
      <div class="mt-5 max-w-[62ch] space-y-4 text-[1.0625rem] leading-relaxed text-muted">
        {built.map((para) => <p>{para}</p>)}
      </div>

      <p class="mt-10 font-mono text-[11px] uppercase tracking-[0.15em] text-muted">
        {stack.join("  ·  ")}
      </p>
    </div>
  </div>
</article>
