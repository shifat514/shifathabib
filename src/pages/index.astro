---
import Layout from "../layouts/Layout.astro";
import Masthead from "../components/Masthead.astro";
import Hero from "../components/Hero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CaseStudy from "../components/CaseStudy.astro";
import Currently from "../components/Currently.astro";
import ContactFooter from "../components/ContactFooter.astro";

const work = [
  {
    title: "Zeda CTMS",
    meta: "Healthcare SaaS — zeda.ai",
    href: "https://zeda.ai/",
    years: "2022 — Present",
    metric: {
      value: "0",
      label: "Production disruptions across a two-major-version migration",
    },
    problem:
      "Clinical trials still run on paperwork: consent forms to sign, source documents to review, site calls to log. Zeda's CTMS replaces that workflow, which means the frontend has to handle documents and calls as first-class citizens — not as attachments.",
    built: [
      "I built the e-signature experience on PDF.js: a viewer where coordinators place signature and text fields on any PDF by drag-and-drop, and a companion annotation viewer for reviewing completed documents. I also built a Twilio-powered call assistant that keeps the live transcript in sync with the audio and produces AI-generated summaries after each call.",
      "Alongside the features, I led the Vue 2→3 and Vuetify 2→3 migration incrementally on a live product, and set up the Playwright end-to-end suite and Bitbucket Pipelines CI that kept it safe.",
    ],
    stack: ["Vue 3", "Vuetify", "PDF.js", "Twilio", "Playwright", "Bitbucket Pipelines"],
  },
  {
    title: "Olosh",
    meta: "AI personal knowledge app — side project, in active development",
    years: "2026 — Present",
    metric: {
      value: "~95%",
      label: "Categorization accuracy on real-world notes",
    },
    problem:
      "Most capture tools assume you think in English. People here think in Banglish — Bengali written in Latin script, mixed with English mid-sentence — and generic note apps can't organize it.",
    built: [
      "Olosh is mine end-to-end: a FastAPI backend, Llama 3.3 70B via Groq for understanding, and ChromaDB embeddings for retrieval. The core is a Banglish-first intake pipeline that reads a raw note and files it correctly — currently around 95% categorization accuracy on my own real-world notes.",
      "It's the project where the AI work stops being a demo: prompt design, evaluation against real data, and the unglamorous plumbing between model and product.",
    ],
    stack: ["FastAPI", "Groq / Llama 3.3 70B", "ChromaDB", "Python"],
  },
  {
    title: "Somoyer School / FluencyFirst",
    meta: "Edtech — somoy.school",
    href: "https://somoy.school/",
    years: "2021 — 2022",
    metric: {
      value: "+30%",
      label: "Lighthouse performance via LCP & CLS work",
    },
    problem:
      "An early-stage edtech platform with one frontend engineer: me. Every screen, component decision, and performance regression was mine to own.",
    built: [
      "I built the modular learning system — courses, lessons, and practice flows assembled from reusable blocks — and then made it fast, lifting Lighthouse scores about 30% by fixing largest-contentful-paint and layout-shift issues rather than chasing micro-optimizations.",
    ],
    stack: ["Vue", "Sole frontend owner"],
  },
];
---

<Layout
  title="Shifat Habib — Frontend Engineer"
  description="Frontend engineer with 3+ years of Vue.js in production across healthcare SaaS and edtech, now shipping AI-powered products end-to-end."
>
  <Masthead />
  <main id="main">
    <Hero />

    <section id="work" aria-labelledby="work-title" class="border-t border-line">
      <SectionHeader index="01" title="Selected Work" titleId="work-title" />
      {work.map((entry) => <CaseStudy {...entry} />)}
    </section>

    <Currently />
    <ContactFooter />
  </main>
</Layout>
