---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404" description="Page not found.">
  <main>
    <div class="flex justify-center px-4">
      <div class="w-[1000px] mt-16 sm:mt-20">
        <div
          class="text-white bg-surface border border-chrome rounded-lg font-spacemono text-xs sm:text-base"
        >
          <div class="bg-chrome h-10 rounded-t-md flex items-center justify-between px-4">
            <div class="w-3"></div>
            <div class="font-spacemono_bold">Terminal</div>
            <div class="h-3 w-3 rounded-full bg-accent" aria-hidden="true"></div>
          </div>
          <div class="p-4 sm:p-6">
            <h1 class="font-spacemono_bold text-white mb-2">
              404 — No such file or directory
            </h1>
            <div>
              <span class="text-gray-400">shifat@pc:~$</span> cd /that/page
            </div>
            <div class="text-gray-400">
              bash: cd: /that/page: No such file or directory
            </div>
            <div>
              <span class="text-gray-400">shifat@pc:~$</span> ls
            </div>
            <div class="flex flex-wrap gap-x-8">
              <a
                href="/"
                class="text-path hover:bg-accent hover:text-background px-1"
                >home/</a
              >
              <a
                href="/about"
                class="text-path hover:bg-accent hover:text-background px-1"
                >about/</a
              >
              <a
                href="/projects"
                class="text-path hover:bg-accent hover:text-background px-1"
                >projects/</a
              >
            </div>
            <div>
              <span class="text-gray-400">shifat@pc:~$</span> _
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
